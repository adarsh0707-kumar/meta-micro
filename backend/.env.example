DATABASE_URL=postgresql+psycopg2://meta_micro:meta_micro@localhost:5432/meta_micro
LOG_LEVEL=INFO
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# WhatsApp Business Cloud API (Meta). Leave WHATSAPP_PROVIDER=log for local
# development -- outgoing messages are logged instead of sent.
WHATSAPP_PROVIDER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0
# Webhook (inbound messages + delivery receipts). VERIFY_TOKEN is any string you
# also type into Meta's dashboard; APP_SECRET comes from the Meta app settings and
# is required -- without it the webhook rejects every delivery.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

CORS_ORIGINS=["http://localhost:5173"]
